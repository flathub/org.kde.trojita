{
    "app-id": "org.kde.trojita",
    "runtime": "org.kde.Platform",
    "runtime-version": "5.15-21.08",
    "sdk": "org.kde.Sdk",
    "base": "io.qt.qtwebkit.BaseApp",
    "base-version": "5.15-21.08",
    "command": "trojita",
    "rename-icon": "trojita",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--device=dri",
        "--persist=.abook"
    ],
    "modules": [
        {
            "name": "boost",
            "buildsystem": "simple",
            "build-commands": [
                "./bootstrap.sh --prefix=/app --with-libraries=system",
                "./b2 -j $FLATPAK_BUILDER_N_JOBS install"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://boostorg.jfrog.io/artifactory/main/release/1.87.0/source/boost_1_87_0.tar.bz2",
                    "sha256": "af57be25cb4c4f4b413ed692fe378affb4352ea50fbe294a11ef548f4d527d89",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 6845,
                        "stable-only": true,
                        "url-template": "https://boostorg.jfrog.io/artifactory/main/release/$version/source/boost_${major}_${minor}_$patch.tar.bz2"
                    }
                }
            ]
        },
        {
            "name": "gpgme",
            "builddir": true,
            "sources": [
                {
                    "type": "archive",
                    "url": "https://gnupg.org/ftp/gcrypt/gpgme/gpgme-1.24.1.tar.bz2",
                    "sha256": "ea05d0258e71061d61716584ec34cef59330a91340571edc46b78374973ba85f",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 1239,
                        "stable-only": true,
                        "url-template": "https://gnupg.org/ftp/gcrypt/gpgme/gpgme-$version.tar.bz2"
                    }
                }
            ]
        },
        {
            "name": "trojita",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DWITH_TESTS=OFF",
                "-DWITH_QT5=ON",
                "-DWITH_ZLIB=ON",
                "-DWITH_RAGEL=OFF"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://invent.kde.org/pim/trojita.git",
                    "commit": "70902f213dafe5bbdd4fc8b0f7288b222276c1c3"
                }
            ]
        }
    ]
}
